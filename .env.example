# 따소미 챗봇의 GPT 연동(/api/chat, /api/chatbot-interpret) — 아래 값이 하나라도 없으면
# 두 엔드포인트 모두 항상 비활성 상태로 동작한다(fail-closed, OpenAI를 호출하지 않음).
# 로컬 개발: 이 내용을 .env.local로 복사해서 값을 채운 뒤 `vercel dev`로 실행한다.
# 배포: Vercel 프로젝트 설정 > Environment Variables에 동일한 키로 등록한다.

# 서버에서만 사용 — 절대 VITE_ 접두사를 붙이지 말 것(붙이면 브라우저 빌드에 노출됨)
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4.1-mini

# 전체 킬스위치 — false 또는 미설정이면 두 엔드포인트 모두 항상 비활성 응답만 반환
GPT_CHAT_ENABLED=false

# 경량 접근 토큰 — 서버와 클라이언트에 같은 값을 각각 넣어야 한다 (완전한 사용자 인증은 아님, 남용 방지용)
APP_TOKEN=
VITE_APP_TOKEN=
